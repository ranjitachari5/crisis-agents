# Copy to backend/.env and fill in. Never commit the real .env.
ENV=dev                     # dev | prod. Outside dev, weak tokens make the server refuse to start.

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_ENABLED=true
LLM_TIMEOUT_S=12
LLM_AGREEMENT_SUMMARIES=true

DATABASE_URL=sqlite:///./crisis_agents.db
DB_AUTO_CREATE=             # empty: create_all in dev, Alembic `upgrade head` otherwise
TICK_INTERVAL_S=5
SIM_MINUTES_PER_TICK=15
CHAT_MESSAGE_DELAY_MS=250
MAX_NEGOTIATION_ROUNDS=5
RANDOM_SEED=42

# --- Authentication: send `Authorization: Bearer <token>` -------------------
# Roles: viewer (GET + WebSocket) < commander (operational control) < admin (reset/step/injection).
# Outside dev each token must be >= 24 chars, and admin must differ from commander.
COMMANDER_AUTH_TOKEN=change-me
ADMIN_AUTH_TOKEN=           # empty in dev: the commander token also acts as admin
VIEWER_AUTH_TOKEN=          # empty: read-only routes and the WebSocket are public
ENABLE_TEST_ROUTES=         # empty: enabled only in dev (reset, step, inject-fake)
AUTH_MAX_FAILURES_PER_MIN=10
MAX_REQUEST_BYTES=65536

# --- Trust / replay protection ----------------------------------------------
MESSAGE_MAX_AGE_S=300
MESSAGE_CLOCK_SKEW_S=30

# --- Runs, approvals, WebSocket ---------------------------------------------
MAX_RUNS=8
RUN_TTL_S=3600
APPROVAL_TIMEOUT_S=120      # 0 disables expiry of proposals awaiting manual approval
APPROVAL_TIMEOUT_POLICY=keep_last   # keep_last | commit
WS_CLIENT_QUEUE=256
WS_MAX_INBOUND_BYTES=4096
WS_MAX_INBOUND_PER_S=20

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
